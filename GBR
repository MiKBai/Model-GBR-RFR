# ==========================================
print("📊Organizing ...")

# 
df_shap = pd.DataFrame(shap_values, columns=X_train_renamed.columns, index=X_train.index)
df_features = X_train_renamed.copy()
df_shap.index.name = 'Sample_Name'     
df_features.index.name = 'Sample_Name' 

# 
shap_melted = df_shap.reset_index().melt(id_vars='Sample_Name', var_name='Feature_Name', value_name='SHAP_Value')
feature_melted = df_features.reset_index().melt(id_vars='Sample_Name', var_name='Feature_Name', value_name='Feature_Value_Raw')

# 
df_origin = pd.merge(shap_melted, feature_melted, on=['Sample_Name', 'Feature_Name'])

# 
df_origin['Color_Value'] = df_origin.groupby('Feature_Name')['Feature_Value_Raw'].transform(
    lambda x: (x - x.min()) / (x.max() - x.min() + 1e-9)
)

# 
mean_abs_shap = np.abs(df_shap).mean().sort_values(ascending=True)
importance_map = {name: i for i, name in enumerate(mean_abs_shap.index)}
df_origin['Y_Base'] = df_origin['Feature_Name'].map(importance_map)

#  
np.random.seed(42)
jitter = np.random.uniform(-0.25, 0.25, size=len(df_origin))
df_origin['Y_With_Jitter'] = df_origin['Y_Base'] + jitter

# ==========================================
origin_output_file = 'origin_shap_plot_dataGBR.csv'
df_origin.to_csv(origin_output_file, index=False, encoding='utf-8-sig')


df_ticks = pd.DataFrame(list(importance_map.items()), columns=['Feature_Name', 'Y_Tick_Index'])
df_ticks.to_csv('origin_y_ticks.csv', index=False, encoding='utf-8-sig')

